CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_LOCALVERSION="-android13-8-00005-g2d8ad9139b89-ab15063902"
# CONFIG_LOCALVERSION_AUTO is not set
# RUN #16 LESSON - the stock kernel has CONFIG_MODULE_SCMVERSION=y and our build path never set it,
# which is exactly the kind of release-build config the vendor modules were built against. Google's
# release builds get it from build.config.gki.aarch64; the kleaf path we use does not, so state it.
CONFIG_MODULE_SCMVERSION=y
