CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
# RUN #18 LESSON - why this fragment no longer pins the version, and why we now build with
# --config=stamp.
#
#   common/init/Kconfig:2165:
#       config MODULE_SCMVERSION
#           bool "SCM version for modules"
#           depends on LOCALVERSION_AUTO
#
# kleaf DISABLES CONFIG_LOCALVERSION_AUTO whenever --config=stamp is absent (its _scmversion_config_cmd
# runs `scripts/config -d LOCALVERSION_AUTO`), so MODULE_SCMVERSION could never be enabled in our build
# no matter what this fragment said. The stock kernel has BOTH:
#       CONFIG_LOCALVERSION_AUTO=y      CONFIG_MODULE_SCMVERSION=y      CONFIG_LOCALVERSION=""
# and MODULE_SCMVERSION contributes to the MODULE vermagic, so the stock vendor modules carry it and a
# kernel without it refuses to load them.
#
# So: the build now passes --config=stamp, LOCALVERSION_AUTO stays on, MODULE_SCMVERSION becomes
# selectable, and the release string comes from kleaf's real SCM machinery - which reads
# common/.scmversion, a file step 6 pins to the exact stock value. The old pin here
# (CONFIG_LOCALVERSION="...") is therefore REMOVED: with stamp on it would double the suffix.
CONFIG_MODULE_SCMVERSION=y
