CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# ---------------------------------------------------------------------------
# Where this list comes from, and why it is exactly this
#
#   * SUSFS lives on GITLAB (gitlab.com/simonpunk/susfs4ksu), branch
#     gki-android16-6.12. The workflow clones that branch, optionally pins it to
#     susfs_commit, and applies 50_add_susfs_in_gki-android16-6.12.patch.
#   * KernelSU-Next must be the SUSFS-carrying fork (pershoot dev-susfs).
#     Against upstream KernelSU-Next these options do not exist, so kconfig drops
#     every CONFIG_KSU_SUSFS_* line silently - the kernel would build, boot, and
#     hide nothing. The workflow therefore greps that fork's kernel/Kconfig and
#     fails in ~2 minutes if KSU_SUSFS is absent.
#   * This is the same set the WildKernels android16-6.12 builds use, so the
#     resulting kernel behaves like the "Wild Kernel 6.12.69" that is on the
#     phone today (SUSFS v2.1.x, inline hooks).
#
# CONFIG_MODULE_SCMVERSION is deliberately NOT here, unlike the Nothing Phone
# (2a) pipeline where the stock vendor modules required it. Evidence, read
# straight off this device:
#
#     $ su -c "strings /vendor/lib/modules/*.ko | grep -m1 vermagic="
#     vermagic=6.12.69-android16-6-g6a49175400c0-ab16238327-4k SMP preempt mod_unload modversions aarch64
#
# - no "scmversion" token. And because the device has CONFIG_MODVERSIONS=y, the
# kernel's same_magic(..., has_crcs=true) skips the version token of the vermagic
# entirely and compares only the flag part, so the symbol CRCs are the real gate.
# Those CRCs are frozen per KMI generation, which is why the ACK branch must be
# common-android16-6.12-* and nothing else.
# ---------------------------------------------------------------------------
