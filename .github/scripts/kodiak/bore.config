# ---------------------------------------------------------------------------
# BORE scheduler - Phase 3 of the heybooboo port. Applied ONLY when
# features=phase3 (so phase-1/2 builds are untouched; kconfig silently drops
# this line when the CONFIG_SCHED_BORE symbol does not exist, which is what
# happens on a build that did not apply phase3-bore.patch).
#
# The whole phase - BORE itself plus the PELT 2x multiplier, the uclamp top-app
# floor and its hard-lock fix - arrives as ONE patch,
# .github/scripts/kodiak/patches/phase3-bore.patch, which also adds this Kconfig
# entry. See _kernel_ref/build_phase3.py for how it was rebased onto 6.12.69.
#
# BORE keeps its 32-byte per-task state in the four ANDROID_KABI_RESERVE slots
# (ANDROID_KABI_USE(4..7, u64)) rather than a union, so struct task_struct keeps
# its size and every offset. The struct-layout gate (btf_structs.py) is the check.
# ---------------------------------------------------------------------------
CONFIG_SCHED_BORE=y
