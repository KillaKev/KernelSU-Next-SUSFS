# ---------------------------------------------------------------------------
# NoMount - built-in VFS path redirection (maxsteeel/nomount).
# Applied ONLY when nomount=on. The symbol comes from fs/nomount/Kconfig, which
# the "NoMount - integrate the VFS path redirection framework" step adds to
# fs/Kconfig, so this line is dropped with a warning if that step did not run.
#
# Their src/Kconfig declares
#     config NOMOUNT
#         tristate "NoMount Path Redirection Subsystem"
#         default y
# with no select and no depends, so this is the entire config requirement. =y
# (built-in, not =m) is the point: the NoMount metamodule probes for built-in
# support with `bin/nm version` and otherwise falls back to a pre-compiled
# nomount.ko in the module's lkm/ folder - which is missing on this device and
# is what made it print "Kernel not patched or module failed to load" and
# disable itself. Built-in removes that dependency entirely.
# ---------------------------------------------------------------------------
CONFIG_NOMOUNT=y
