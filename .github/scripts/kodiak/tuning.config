# ---------------------------------------------------------------------------
# Feature tuning - Phase 1 + Phase 2 of the asdfmonster261/heybooboo-kernel port.
#
# WHERE THIS COMES FROM
#   heybooboo-kernel (branch `ksunext-susfs`) is a GKI kernel for the same KMI
#   line as this pipeline (android16-6.12) with KernelSU-Next + SUSFS built in,
#   plus the feature set below. Its entire config delta lives in one file,
#   arch/arm64/configs/heybooboo_gki.fragment, and its entire *code* delta lives
#   in the single-purpose commits listed in the workflow step
#   "Features - apply the heybooboo feature patches".
#
#   That branch is based on **6.12.93**; this pipeline is pinned to **6.12.69**
#   (the sublevel the phone boots, and therefore the only CRC-safe choice). So
#   nothing is merged: their code patches are cherry-picked by SHA and their
#   config lines are reproduced here, line for line, minus what we must not take.
#
# WHAT IS DELIBERATELY *NOT* HERE
#   CONFIG_SCHED_BORE (+ PELT x2 / uclamp top-app floor)  -> phase 3, scheduler
#   CONFIG_BBG + `baseband_guard` in CONFIG_LSM           -> phase 4, new LSM
#   CONFIG_MODULE_SIG_PROTECT_LIST=""                     -> NO. That is how
#       heybooboo defuses the protected-exports refusals. It is exactly the move
#       that bootlooped the phone in run #29: emptying build *inputs* (the
#       protected list feeds the ABI symbollists) shrank Module.symvers
#       633->585 KB, damaged the export set and produced a kernel that could not
#       load its own modules. Our narrower one-line condition defuse in
#       kernel/module/main.c is already proven on-device (run #30: 371 modules,
#       0 protected-export refusals) and changes no build input, so it stays.
#
# WHAT IS ALREADY SET IN OUR TREE (kept here anyway - apply_line is idempotent,
# and a line in this file is also a statement of intent that can be diffed):
#   CONFIG_BINFMT_MISC/SCRIPT/ELF=y, CONFIG_TCP_CONG_ADVANCED=y,
#   CONFIG_TCP_CONG_BBR=y, CONFIG_NET_SCH_FQ=y, CONFIG_NET_SCH_FQ_CODEL=y,
#   CONFIG_UTS_NS=y, CONFIG_NET_NS=y
# ---------------------------------------------------------------------------

# --- containers: namespaces -------------------------------------------------
# SYSVIPC/IPC_NS are the pair worth staring at: this tree has SYSVIPC=off, and
# turning it on adds sysvsem/sysvshm to struct task_struct. The phase-1 commit
# 912738df5c ("sched: move sysvipc fields into kABI alignment padding", the
# Droidspaces GKI kABI patch) relocates them into packed __kabi_ignored unions
# right after rt_priority so later task_struct offsets do not move. That patch is
# applied by the same step as this file - never enable these two without it.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y

# --- containers: init/exec plumbing -----------------------------------------
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set      <- Android's init owns /dev; do not hand it to the kernel
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_ELF=y

# --- ntsync (drivers/misc/ntsync.c, commit cb00795956) ----------------------
CONFIG_NTSYNC=y

# --- TCP: BBRv3 (net/ipv4/tcp_bbr3.c, commit 584b8b68ff) --------------------
# Their Kconfig (net/ipv4/Kconfig +22) defines TCP_CONG_BBR3 / DEFAULT_BBR3; both
# lines below are inert until that patch is applied, which is why the patch step
# runs BEFORE this config is applied.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y

# --- queueing disciplines / actions ----------------------------------------
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_ACT_CONNMARK=y

# --- netfilter matches/targets + ipset --------------------------------------
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=65534
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_IPMAC=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_LIST_SET=y

# NOTE: no CONFIG_VFS_CACHE_PRESSURE line exists - vfs_cache_pressure is a sysctl
# variable, not a Kconfig symbol. Its default is lowered to 50 by the f2fs/vfs
# patch group (commit 0d960a53d0, fs/dcache.c).
